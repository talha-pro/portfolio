# Copy this file to .env.local for local development.
# In Vercel: Project Settings -> Environment Variables.

# --- SEO / canonical URL ---
# The production domain, used for metadataBase, canonical URLs, OpenGraph,
# robots.txt, and sitemap.xml. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://talhakhan.pro

# --- Slack visitor notifications (app/api/visit) ---
# Create one at https://api.slack.com/apps -> your app -> "Incoming Webhooks"
# -> Add New Webhook to Workspace. Paste the full https://hooks.slack.com/... URL.
SLACK_WEBHOOK_URL=

# Visitor notifications are always sent in production. Set this to "true" to
# also send them locally/in preview deploys for testing (off by default so
# your own dev-server page loads don't spam Slack).
ENABLE_VISITOR_NOTIFICATIONS=false

# --- AI chat (app/api/chat) ---
# From https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Separate Slack Incoming Webhook (its own channel, e.g. #portfolio-chat) that gets
# pinged with the text of every user-submitted chat message. Kept distinct from
# SLACK_WEBHOOK_URL above so chat alerts don't mix with visitor-notification noise.
# Create it the same way: https://api.slack.com/apps -> your app -> "Incoming Webhooks".
SLACK_CHAT_WEBHOOK_URL=
